{
  "name": "scs-earnings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Senior Civil Servant Earnings — interactive explorer of UK SCS pay over time by department, role type, profession, grade, DDaT vs policy, built on gov.uk organogram transparency data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/ingest.mjs",
    "ukgwa": "node scripts/ukgwa.mjs",
    "benchmarks": "node scripts/benchmarks.mjs",
    "test": "node scripts/test-lib.mjs",
    "datadiff": "node scripts/datadiff.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:fonts": "node scripts/check-font-sizes.mjs",
    "validate:palette": "node scripts/validate-palette.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
