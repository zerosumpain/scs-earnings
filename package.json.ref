{
  "name": "marble-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "2D physics marble-run game: race colored balls through obstacles/effects/hazards to a green goal, with a drag-drop builder and seeded procedural generation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench:eval": "node scripts/bench-eval.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "0.18.2",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
